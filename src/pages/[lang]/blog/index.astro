---
import RedirectLayout from '../../../layouts/RedirectLayout.astro';
import { defaultLocale, isLocaleCode, localeCodes } from '../../../data/i18n/locales';

export function getStaticPaths() {
	return localeCodes
		.filter((code) => code !== defaultLocale)
		.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang ?? '';
const fromPath = `/${lang}/blog/`;
---

{
	isLocaleCode(lang) ? (
		<RedirectLayout
			target="/blog/"
			from={fromPath}
			title="Redirecting to Naraka Cheats blog"
			description="English-only blog — redirecting to the Naraka Cheats blog."
		/>
	) : (
		<RedirectLayout target="/blog/" from={fromPath} />
	)
}
