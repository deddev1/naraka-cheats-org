---
import RedirectLayout from '../../../../layouts/RedirectLayout.astro';
import { blogPosts } from '../../../../data/blog/helpers';
import { defaultLocale, isLocaleCode, localeCodes } from '../../../../data/i18n/locales';

export function getStaticPaths() {
	const paths: { params: { lang: string; slug: string } }[] = [];

	for (const locale of localeCodes) {
		if (locale === defaultLocale) continue;
		for (const post of blogPosts) {
			paths.push({
				params: { lang: locale, slug: post.translations[defaultLocale].slug },
			});
		}
	}

	return paths;
}

const lang = Astro.params.lang ?? '';
const slug = Astro.params.slug ?? '';
const fromPath = `/${lang}/blog/${slug}/`;
const target = `/blog/${slug}/`;
const post = blogPosts.find((entry) => entry.translations.en.slug === slug);
const postTitle = post?.translations.en.title ?? 'Naraka Cheats blog post';
const redirectTitle = `${postTitle} (${lang.toUpperCase()}) | Redirect`;
const redirectDescription = `English-only article — redirecting to ${postTitle} on the Naraka Cheats blog.`;
---

{
	isLocaleCode(lang) ? (
		<RedirectLayout
			target={target}
			from={fromPath}
			title={redirectTitle}
			description={redirectDescription}
		/>
	) : (
		<RedirectLayout target="/blog/" from={fromPath} />
	)
}
