---
import { narakaImages } from '../data/naraka';
import { getGalleryUi } from '../data/i18n/gallery-ui';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { absoluteImageUrl } from '../data/page-images';
import { getT } from '../i18n/server';
import ImageCarousel from './ImageCarousel.astro';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const gallery = getGalleryUi(locale);
const t = getT(locale);

const galleryImages = narakaImages.gallery.map((image) => ({
	src: image.src,
	url: 'url' in image && image.url ? image.url : absoluteImageUrl(image.src),
	alt: image.alt,
}));
---

<section class="gallery" id="gallery" aria-labelledby="gallery-title">
	<h2 id="gallery-title" class="gallery__title">{gallery.title}</h2>
	<p class="gallery__sub">{gallery.subtitle}</p>

	<ImageCarousel
		images={galleryImages}
		prevLabel={t('common.prevImage')}
		nextLabel={t('common.nextImage')}
	/>
</section>

<style>
	.gallery__title {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 700;
	}

	.gallery__sub {
		margin: 0.5rem 0 1.25rem;
		color: var(--color-muted);
		font-size: 0.9375rem;
		line-height: 1.5;
		max-width: 36rem;
	}
</style>
