---
import { getLocalizedHomeFaqs } from '../data/localized-faq';
import { getFaqPath } from '../data/faq';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { getLocalizedPath } from '../data/i18n/routing';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = getT(locale);

const faqs = getLocalizedHomeFaqs(locale).map((item) => ({
	slug: item.slug,
	question: item.question,
	answer: item.answer,
	href: getFaqPath(item.slug),
}));

const categories = [
	{
		titleKey: 'homeSeo.catFeatures',
		hintKey: 'homeSeo.catFeaturesHint',
		links: [
			{ href: getLocalizedPath('features', locale), labelKey: 'homeSeo.linkAllFeatures' },
			{ href: getLocalizedPath('naraka-esp', locale), labelKey: 'homeSeo.linkEsp' },
			{ href: getLocalizedPath('naraka-aimbot', locale), labelKey: 'homeSeo.linkAimbot' },
			{ href: getLocalizedPath('radar', locale), labelKey: 'homeSeo.linkRadar' },
		],
	},
	{
		titleKey: 'homeSeo.catStatus',
		hintKey: 'homeSeo.catStatusHint',
		links: [
			{ href: getLocalizedPath('updates', locale), labelKey: 'homeSeo.linkLiveStatus' },
			{ href: getLocalizedPath('home', locale), labelKey: 'homeSeo.linkUndetected' },
			{ href: getLocalizedPath('setup', locale), labelKey: 'homeSeo.linkSetup' },
			{ href: getLocalizedPath('faq', locale), labelKey: 'homeSeo.linkFaq' },
		],
	},
	{
		titleKey: 'homeSeo.catStore',
		hintKey: 'homeSeo.catStoreHint',
		links: [
			{ href: getLocalizedPath('pricing', locale), labelKey: 'homeSeo.linkPlans' },
			{ href: '/reviews/', labelKey: 'homeSeo.linkReviews' },
			{ href: getLocalizedPath('hacks', locale), labelKey: 'homeSeo.linkFinalsCheats' },
			{ href: getLocalizedPath('features', locale), labelKey: 'homeSeo.linkAllFeatures' },
		],
	},
	{
		titleKey: 'homeSeo.catHelp',
		hintKey: 'homeSeo.catHelpHint',
		links: [
			{ href: getLocalizedPath('support', locale), labelKey: 'homeSeo.linkSupport' },
			{ href: getLocalizedPath('setup', locale), labelKey: 'homeSeo.linkSetupGuide' },
			{ href: '/blog/', labelKey: 'homeSeo.linkBlog' },
			{ href: getLocalizedPath('refund', locale), labelKey: 'homeSeo.linkRefunds' },
		],
	},
];

const faqIndexHref = getLocalizedPath('faq', locale);
---

<section class="home-seo shell" aria-labelledby="home-seo-title">
	<header class="home-seo__head">
		<div>
			<p class="home-seo__eyebrow">{t('homeSeo.eyebrow')}</p>
			<h2 id="home-seo-title">{t('homeSeo.title')}</h2>
			<p class="home-seo__lede">{t('homeSeo.lede')}</p>
		</div>
	</header>

	<div class="home-seo__cats">
		{
			categories.map((cat) => (
				<nav class="home-seo__cat" aria-label={t(cat.titleKey)}>
					<header class="home-seo__cat-head">
						<h3>{t(cat.titleKey)}</h3>
						<p>{t(cat.hintKey)}</p>
					</header>
					<ul>
						{cat.links.map((link) => (
							<li>
								<a href={link.href}>
									<span>{t(link.labelKey)}</span>
									<span class="home-seo__cat-arrow" aria-hidden="true" />
								</a>
							</li>
						))}
					</ul>
				</nav>
			))
		}
	</div>

	<section class="home-seo__faq" aria-labelledby="home-faq-title">
		<header class="home-seo__faq-head">
			<div>
				<p class="home-seo__eyebrow">{t('homeSeo.faqEyebrow')}</p>
				<h3 id="home-faq-title">{t('homeSeo.faqTitle')}</h3>
				<p class="home-seo__faq-lede">{t('homeSeo.faqLede')}</p>
			</div>
			<a class="home-seo__faq-link" href={faqIndexHref}>
				{t('homeSeo.allAnswers')}
			</a>
		</header>
		<div class="home-seo__faq-list">
			{
				faqs.map((item) => (
					<details class="home-seo__item" id={item.slug}>
						<summary>
							<span>{item.question}</span>
							<span class="home-seo__chev" aria-hidden="true" />
						</summary>
						<div class="home-seo__item-body">
							<p>{item.answer}</p>
							<a class="home-seo__item-link" href={item.href}>
								{t('homeSeo.openFullPage')}
							</a>
						</div>
					</details>
				))
			}
		</div>
	</section>
</section>

<style>
	.home-seo {
		padding-block: clamp(2.75rem, 5vw, 4rem);
		color: var(--ink-muted);
		font-size: 0.9375rem;
		line-height: 1.55;
	}

	.home-seo__head {
		margin-bottom: 1.35rem;
		padding-bottom: 1.2rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.home-seo__eyebrow {
		margin: 0 0 0.4rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--magenta-soft);
	}

	.home-seo__head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.05rem, 1.8vw, 1.2rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.25;
		color: var(--ink);
	}

	.home-seo__lede {
		margin: 0.45rem 0 0;
		max-width: 32rem;
		font-size: 0.9rem;
		color: var(--ink-muted);
	}

	.home-seo__cats {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.65rem;
		align-items: stretch;
	}

	.home-seo__cat {
		display: flex;
		flex-direction: column;
		min-height: 100%;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-panel);
		overflow: hidden;
		transition: border-color 0.2s ease;
	}

	.home-seo__cat:hover {
		border-color: color-mix(in srgb, var(--magenta) 28%, var(--line));
	}

	.home-seo__cat-head {
		padding: 0.9rem 1rem 0.75rem;
		border-bottom: 1px solid var(--line-soft);
		background: color-mix(in srgb, var(--bg-elevated) 80%, transparent);
	}

	.home-seo__cat-head h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.home-seo__cat-head p {
		margin: 0.25rem 0 0;
		font-size: 0.75rem;
		line-height: 1.35;
		color: var(--ink-faint);
	}

	.home-seo__cat ul {
		margin: 0;
		padding: 0.25rem 0;
		list-style: none;
		display: grid;
		flex: 1;
	}

	.home-seo__cat a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		min-height: var(--touch-min, 2.75rem);
		padding: 0.7rem 1rem;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--ink-muted);
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	.home-seo__cat-arrow {
		width: 0.35rem;
		height: 0.35rem;
		flex-shrink: 0;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: rotate(-45deg);
		opacity: 0;
		transition:
			opacity 0.15s ease,
			transform 0.15s ease;
	}

	.home-seo__cat a:hover {
		background: color-mix(in srgb, var(--magenta) 8%, transparent);
		color: var(--accent-hover);
	}

	.home-seo__cat a:hover .home-seo__cat-arrow {
		opacity: 0.9;
		transform: rotate(-45deg) translate(1px, 1px);
	}

	.home-seo__faq {
		margin-top: 2.25rem;
		padding: clamp(1.35rem, 3vw, 1.85rem);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg, 1rem);
		background:
			radial-gradient(ellipse 70% 80% at 100% 0%, color-mix(in srgb, var(--magenta) 10%, transparent), transparent 50%),
			var(--bg-panel);
	}

	.home-seo__faq-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.15rem;
		padding-bottom: 1.05rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.home-seo__faq-head h3 {
		margin: 0.15rem 0 0;
		font-family: var(--font-display);
		font-size: clamp(1.2rem, 2.2vw, 1.45rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.25;
		color: var(--ink);
	}

	.home-seo__faq-lede {
		margin: 0.45rem 0 0;
		max-width: 36rem;
		font-size: 1rem;
		line-height: 1.55;
		color: var(--ink-muted);
	}

	.home-seo__faq-link {
		flex-shrink: 0;
		margin-top: 0.35rem;
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--magenta-soft);
		text-decoration: none;
		white-space: nowrap;
	}

	.home-seo__faq-link:hover {
		color: var(--ink);
	}

	.home-seo__faq-list {
		display: grid;
		gap: 0.55rem;
	}

	.home-seo__item {
		margin: 0;
		border: 1px solid var(--line);
		border-radius: var(--radius-md, 0.75rem);
		background: color-mix(in srgb, var(--bg) 55%, var(--bg-elevated));
		overflow: hidden;
	}

	.home-seo__item[open],
	.home-seo__item:hover {
		border-color: color-mix(in srgb, var(--magenta) 28%, var(--line));
	}

	.home-seo__item summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		cursor: pointer;
		list-style: none;
		padding: 1.05rem 1.15rem;
		font-size: 1.0625rem;
		font-weight: 600;
		line-height: 1.4;
		color: var(--ink);
	}

	.home-seo__item summary::-webkit-details-marker {
		display: none;
	}

	.home-seo__item[open] summary {
		border-bottom: 1px solid var(--line-soft);
		color: var(--magenta-soft);
	}

	.home-seo__chev {
		position: relative;
		width: 1.05rem;
		height: 1.05rem;
		flex-shrink: 0;
		border-radius: 999px;
		border: 1px solid var(--line-strong);
	}

	.home-seo__chev::before,
	.home-seo__chev::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		background: var(--magenta-soft);
		border-radius: 999px;
	}

	.home-seo__chev::before {
		width: 0.45rem;
		height: 1.5px;
		transform: translate(-50%, -50%);
	}

	.home-seo__chev::after {
		width: 1.5px;
		height: 0.45rem;
		transform: translate(-50%, -50%);
	}

	.home-seo__item[open] .home-seo__chev::after {
		opacity: 0;
	}

	.home-seo__item-body {
		display: grid;
		gap: 0.75rem;
		padding: 1rem 1.15rem 1.15rem;
	}

	.home-seo__item-body p {
		margin: 0;
		font-size: 1rem;
		line-height: 1.65;
		color: var(--ink-muted);
	}

	.home-seo__item-link {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--magenta-soft);
		text-decoration: none;
	}

	.home-seo__item-link:hover {
		color: var(--ink);
	}

	@media (max-width: 900px) {
		.home-seo__cats {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.home-seo__faq-head {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.75rem;
		}

		.home-seo__faq-link {
			margin-top: 0;
			min-height: var(--touch-min, 2.75rem);
			display: inline-flex;
			align-items: center;
		}
	}

	@media (max-width: 480px) {
		.home-seo__cats {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		.home-seo__faq {
			padding: 1.1rem 1rem 1.15rem;
			margin-top: 1.75rem;
		}

		.home-seo__item summary {
			min-height: var(--touch-min, 2.75rem);
			padding: 0.85rem 1rem;
		}
	}
</style>
